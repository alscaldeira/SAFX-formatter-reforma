@using System.Collections.Generic
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Index", "Home", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data", id = "frmID" }))
{

    <!-- Page heading two starts -->

    <div class="page-heading-two">
        <div class="container">
            <h2>RANFe Light @*<span>Processamento XML</span>*@</h2>
            @*<div class="breads">
                    Home / <a href="#">Page</a> / <a href="#">Sub Page</a>
                </div>*@
            <div class="clearfix"></div>
        </div>
    </div>

    <!-- Page heading two ends -->

    <div class="container">
        <div class="contact-us-two">

            <div class="row">
                <div class="col-md-12">
                    <!-- Contact Form -->
                    <div class="contact-form">
                        <h5>Upload XML's</h5>
                        @* Sem <form> aqui dentro: o Html.BeginForm acima ja e o
                           formulario. HTML nao permite forms aninhados — o parser do
                           navegador descarta a tag interna, e era so por isso que o
                           upload funcionava. Um <div> deixa o layout igual sem
                           depender desse descarte. *@
                        <div class="form" role="form">
                            <div class="container">
                                <div class="row justify-content-start">
                                    <div class="form-group">
                                        <div class="col-sm-1">
                                            <label class="control-label">Empresa:</label>
                                        </div>
                                        <div class="col-sm-3">
                                            <input type="text" name="empresa" id="empresa" class="form-control input-sm" multiple placeholder="Informe o nome da empresa ">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <!-- Form Group -->
                                        @* Um campo so para o lote inteiro. NF-e e CT-e
                                           sao separados pelo conteudo de cada XML, no
                                           ClassificadorXml, e nao por campos distintos
                                           que o usuario tinha de preencher certo. *@
                                        <div class="form-group">
                                            <label class="control-label">Arquivos XML — NF-e, NFS-e e CT-e no mesmo envio (aceita .zip, .eml e .msg):</label>
                                            <input type="file" class="form-control" name="iFile" id="iFile" multiple accept=".xml,.zip,.eml,.msg">
                                            &nbsp;
                                            @* Sem checkbox nao ha como o CT-e (que nao carrega PIS/COFINS
                                               proprio, e cujo ICMS pode ser so uma base informativa)
                                               decidir se calcula esses valores ou sai com "@"/zero. *@
                                            <input type="checkbox" name="chkPisCofins" id="chkPisCofins" />
                                            <label for="chkPisCofins">Calcular PIS/COFINS do CT-e</label>

                                            <input type="checkbox" name="chkIcms" id="chkIcms" />
                                            <label for="chkIcms">Calcular ICMS do CT-e</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row justify-content-start">
                                    <div class="col-sm-4">
                                        <!-- Button -->
                                        <button type="submit" class="btn btn-red">Processar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />

                </div>

            </div>
            @if (ViewBag.Erro != null)
            {
                <div class="row">
                    <div class="col-md-12">
                        <h5 style="color:red;">@ViewBag.Erro</h5>
                    </div>
                </div>
            }
            @if (ViewBag.nomearquivo != null)
            {
                <div class="row">
                    <div class="col-md-12">
                       
                             <h5> <a href="@Url.Content("~/Export/" + ViewBag.NomeArquivo)" target="_blank" style="color:red;">Download do arquivo</a>: @ViewBag.NomeArquivo</h5>
                       
                    </div>
                </div>
            }
            @if (ViewBag.AvisosReforma != null && ((List<string>)ViewBag.AvisosReforma).Count > 0)
            {
                <div class="row">
                    <div class="col-md-12">
                        @* Nao sao erros: o arquivo foi gerado. Aqui entram o XML que
                           ficou de fora do lote, o CT-e que ainda nao vira aba, e os
                           avisos da Reforma — cadastro faltando (o codigo saiu de um
                           palpite) ou dado que o XML nao traz. Tudo isso precisa de
                           conferencia antes de importar no MasterSAF. *@
                        <h5>Pontos a conferir no lote:</h5>
                        <ul>
                            @foreach (string aviso in (List<string>)ViewBag.AvisosReforma)
                            {
                                <li>@aviso</li>
                            }
                        </ul>
                    </div>
                </div>
            }
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
        </div>
    </div>
}